; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Time Shifter"
run/main_scene="res://scenes/test/test_level.tscn"
boot_splash/bg_color=Color(0.18039216, 0.13333334, 0.18431373, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="world"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.18039216, 0.13333334, 0.18431373, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
