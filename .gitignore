# Godot 4
.godot/
/android/
*.translation

# Builds / exports
build/*
!build/.gdignore
export/
*.pck
*.zip

# Godot-generated files that should not be versioned
export_credentials.cfg
*.tmp

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code local settings
.claude/settings.local.json
CLAUDE.local.md

# Asset inbox: content is not versioned, only the marker file
/_inbox/*
!/_inbox/.gdignore

# Lokale Einstellungen (Pfade auf dem eigenen Rechner), nicht versionieren
data/*.local.cfg
