; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Time Shifter"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
boot_splash/bg_color=Color(0.18039216, 0.13333334, 0.18431373, 1)
boot_splash/show_image=false

[autoload]

Upgrades="*res://scripts/autoload/upgrades.gd"
LevelFlow="*res://scripts/autoload/level_flow.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Sfx="*res://scripts/autoload/sfx.gd"
DevMenu="*res://scripts/autoload/dev_menu.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/aseprite_sync/plugin.cfg", "res://addons/building_blocks/plugin.cfg")

[gui]

theme/default_font_antialiasing=0

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,
"resource_local_to_scene": false,
"resource_name": "",
"device": -1,
"window_id": 0,
"alt_pressed": false,
"shift_pressed": false,
"ctrl_pressed": false,
"meta_pressed": false,
"pressed": false,
"keycode": 0,
"physical_keycode": 65,
"key_label": 0,
"unicode": 0,
"location": 0,
"echo": false,
"script": null
)]
}
move_right={
